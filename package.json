{
  "name": "@dschz/solid-create-script",
  "version": "1.2.9",
  "description": "Solid utility hook to dynamically load an external script.",
  "keywords": [
    "create-script",
    "dynamic-script",
    "external-script",
    "hook",
    "inject-script",
    "load-script",
    "script",
    "script-injector",
    "script-loader",
    "solid",
    "solid-create-script",
    "solid-hook",
    "solidjs",
    "use-script"
  ],
  "homepage": "https://github.com/dsnchz/solid-create-script#readme",
  "bugs": {
    "url": "https://github.com/dsnchz/solid-create-script/issues"
  },
  "license": "MIT",
  "author": "Daniel Sanchez <dsanc89@icloud.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsnchz/solid-create-script.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": {},
  "types": "./dist/index.d.ts",
  "typesVersions": {},
  "exports": {
    "solid": "./dist/index.jsx",
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "vite",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "pkg:changeset": "changeset",
    "pkg:version": "changeset version",
    "pkg:publish": "bun run build && changeset publish",
    "serve": "vite preview",
    "start": "vite",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.3",
    "@dschz/load-script": "^1.0.7",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/bun": "^1.2.12",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitest/coverage-istanbul": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-solid": "^0.14.5",
    "jsdom": "^25.0.1",
    "oxfmt": "0.60.0",
    "solid-js": "^1.9.6",
    "tsup": "^8.4.0",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^5.8.3",
    "vite": "6.4.3",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "@dschz/load-script": ">=1.0.7",
    "solid-js": ">=1.6.0 <2.0.0"
  }
}
